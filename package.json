{
  "name": "game-card-creator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Obsidian plugin that creates print-ready game cards (62 x 88 mm) as an A4 PDF from notes.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
